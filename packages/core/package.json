{
  "name": "@sapporta/server",
  "version": "0.2.2",
  "type": "module",
  "description": "Sapporta server — schema-as-code tables, auto-generated CRUD, hierarchical reports, and an OpenAPI-emitting Hono app, all wired up with Drizzle and SQLite.",
  "keywords": [
    "sapporta",
    "framework",
    "hono",
    "drizzle",
    "sqlite",
    "crud",
    "openapi",
    "zod",
    "typescript",
    "rest",
    "api"
  ],
  "author": "Jasim A Basheer <jasim@protoship.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasim/sapporta.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/jasim/sapporta/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/jasim/sapporta/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sapporta": "./bin/sapporta.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "package.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./table": {
      "types": "./dist/schema/table.d.ts",
      "import": "./dist/schema/table.js"
    },
    "./report": {
      "types": "./dist/reports/report.d.ts",
      "import": "./dist/reports/report.js"
    },
    "./errors": {
      "types": "./dist/db/errors.d.ts",
      "import": "./dist/db/errors.js"
    },
    "./create-project": {
      "types": "./dist/create-project.d.ts",
      "import": "./dist/create-project.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./cli/routes": {
      "types": "./dist/cli/routes.d.ts",
      "import": "./dist/cli/routes.js"
    },
    "./cli/http-client": {
      "types": "./dist/cli/http-client.d.ts",
      "import": "./dist/cli/http-client.js"
    },
    "./cli/request": {
      "types": "./dist/cli/request.d.ts",
      "import": "./dist/cli/request.js"
    },
    "./cli/format": {
      "types": "./dist/cli/format.d.ts",
      "import": "./dist/cli/format.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "vendor": "for p in cli ui grid frontend shared honest; do mkdir -p src/templates/dependency-package-snapshots/$p && cp ../$p/package.json src/templates/dependency-package-snapshots/$p/package.json; done",
    "build": "pnpm vendor && rm -rf dist tsconfig.build.tsbuildinfo && tsc -p tsconfig.build.json && cp -R src/templates dist/templates",
    "build:watch": "pnpm vendor && rm -rf dist tsconfig.build.tsbuildinfo && mkdir -p dist && cp -R src/templates dist/templates && tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/templates/tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@sapporta/shared": "workspace:*",
    "commander": "^14.0.3",
    "drizzle-kit": "^0.31.9",
    "winston": "^3.17.0"
  },
  "peerDependencies": {
    "@sapporta/honest": "^0.3.1",
    "@sapporta/rest-core": "3.52.2",
    "better-sqlite3": "^12.0.0",
    "drizzle-orm": "^0.38.4",
    "hono": "^4.7.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@sapporta/honest": "workspace:*",
    "@sapporta/rest-core": "3.52.2",
    "@types/better-sqlite3": "^7.x",
    "better-sqlite3": "^12.0.0",
    "drizzle-orm": "^0.38.4",
    "hono": "^4.7.4",
    "typescript": "^5.7.3",
    "zod": "^4.3.6"
  }
}
