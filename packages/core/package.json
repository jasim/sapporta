{
  "name": "@sapporta/server",
  "version": "0.6.0",
  "type": "module",
  "description": "Sapporta server — schema-as-code tables, auto-generated CRUD, route primitives, and an OpenAPI-emitting Hono app, all wired up with Drizzle and SQLite.",
  "keywords": [
    "sapporta",
    "framework",
    "hono",
    "drizzle",
    "sqlite",
    "crud",
    "openapi",
    "zod",
    "typescript",
    "rest",
    "api"
  ],
  "author": "Jasim A Basheer <jasim@protoship.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasim/sapporta.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/jasim/sapporta/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/jasim/sapporta/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sapporta": "./bin/sapporta.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "package.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "sapporta:source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./table": {
      "types": "./dist/schema/table.d.ts",
      "sapporta:source": "./src/schema/table.ts",
      "default": "./dist/schema/table.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "sapporta:source": "./src/errors.ts",
      "default": "./dist/errors.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "sapporta:source": "./src/testing/index.ts",
      "default": "./dist/testing/index.js"
    },
    "./create-project": {
      "types": "./dist/cli/init-project/create-project.d.ts",
      "sapporta:source": "./src/cli/init-project/create-project.ts",
      "default": "./dist/cli/init-project/create-project.js"
    },
    "./source-link-runtime": {
      "types": "./dist/source-link-runtime.d.ts",
      "sapporta:source": "./src/source-link-runtime.ts",
      "default": "./dist/source-link-runtime.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "sapporta:source": "./src/cli/index.ts",
      "default": "./dist/cli/index.js"
    },
    "./cli/commands": {
      "types": "./dist/cli/commands/registry.d.ts",
      "sapporta:source": "./src/cli/commands/registry.ts",
      "default": "./dist/cli/commands/registry.js"
    },
    "./cli/client": {
      "types": "./dist/cli/client/app-client.d.ts",
      "sapporta:source": "./src/cli/client/app-client.ts",
      "default": "./dist/cli/client/app-client.js"
    },
    "./cli/http-client": {
      "types": "./dist/cli/http-client.d.ts",
      "sapporta:source": "./src/cli/http-client.ts",
      "default": "./dist/cli/http-client.js"
    },
    "./cli/format": {
      "types": "./dist/cli/format.d.ts",
      "sapporta:source": "./src/cli/format.ts",
      "default": "./dist/cli/format.js"
    },
    "./cli/render": {
      "types": "./dist/cli/render/output.d.ts",
      "sapporta:source": "./src/cli/render/output.ts",
      "default": "./dist/cli/render/output.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "vendor": "zx scripts/build.mjs vendor",
    "build": "zx scripts/build.mjs build",
    "build:watch": "zx scripts/build.mjs watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.project-auth.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.6",
    "@sapporta/shared": "workspace:*",
    "commander": "^15.0.0",
    "drizzle-kit": "^0.31.10",
    "nodemailer": "^9.0.1",
    "winston": "^3.19.0"
  },
  "peerDependencies": {
    "@sapporta/honest": "^0.3.12",
    "@sapporta/rest-core": "3.52.2",
    "better-sqlite3": "^12.0.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@better-auth/drizzle-adapter": "~1.7.1",
    "@casl/ability": "^7.0.0",
    "@sapporta/honest": "workspace:^",
    "@sapporta/rest-core": "3.52.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/nodemailer": "^8.0.1",
    "auth": "~1.7.1",
    "better-auth": "~1.7.1",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.27",
    "kysely": "^0.29.3",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  }
}
