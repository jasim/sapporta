{
  "name": "@sapporta/server",
  "version": "0.2.4",
  "type": "module",
  "description": "Sapporta server — schema-as-code tables, auto-generated CRUD, hierarchical reports, and an OpenAPI-emitting Hono app, all wired up with Drizzle and SQLite.",
  "keywords": [
    "sapporta",
    "framework",
    "hono",
    "drizzle",
    "sqlite",
    "crud",
    "openapi",
    "zod",
    "typescript",
    "rest",
    "api"
  ],
  "author": "Jasim A Basheer <jasim@protoship.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasim/sapporta.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/jasim/sapporta/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/jasim/sapporta/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sapporta": "./bin/sapporta.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "package.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./table": "./dist/schema/table.js",
    "./report": "./dist/reports/report.js",
    "./errors": "./dist/db/errors.js",
    "./create-project": "./dist/create-project.js",
    "./cli": "./dist/cli/index.js",
    "./cli/routes": "./dist/cli/routes.js",
    "./cli/http-client": "./dist/cli/http-client.js",
    "./cli/request": "./dist/cli/request.js",
    "./cli/format": "./dist/cli/format.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "vendor": "zx scripts/build.mjs vendor",
    "build": "zx scripts/build.mjs build",
    "build:watch": "zx scripts/build.mjs watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/templates/tsconfig.json && tsc --noEmit -p tsconfig.project-auth.json",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@sapporta/shared": "workspace:*",
    "commander": "^14.0.3",
    "drizzle-kit": "^0.31.10",
    "nodemailer": "^6.10.1",
    "winston": "^3.17.0"
  },
  "peerDependencies": {
    "@sapporta/honest": "^0.3.3",
    "@sapporta/rest-core": "3.52.2",
    "better-sqlite3": "^12.0.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@better-auth/drizzle-adapter": "^1.6.13",
    "@sapporta/honest": "workspace:*",
    "@sapporta/rest-core": "3.52.2",
    "@types/better-sqlite3": "^7.x",
    "@types/nodemailer": "^6.4.17",
    "auth": "^1.6.13",
    "better-auth": "^1.6.13",
    "better-sqlite3": "^12.0.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.4",
    "typescript": "^5.7.3",
    "zod": "^4.3.6"
  }
}
