{
  "name": "%%SAPPORTA:SLUG%%-api",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter %%SAPPORTA:SLUG%%-shared build",
    "dev": "tsc-watch --onFirstSuccess \"%%SAPPORTA:NODE_COMMAND%% --env-file=../../.env.development --watch dist/boot.js\"",
    "prebuild": "pnpm --filter %%SAPPORTA:SLUG%%-shared build",
    "build": "tsc",
    "start": "%%SAPPORTA:NODE_COMMAND%% dist/boot.js",
    "preseed": "pnpm run build",
    "seed": "%%SAPPORTA:NODE_COMMAND%% --env-file=../../.env.development dist/seed.js",
    "predb:generate": "pnpm --filter %%SAPPORTA:SLUG%%-shared build",
    "db:generate": "drizzle-kit generate",
    "predb:generate:custom": "pnpm --filter %%SAPPORTA:SLUG%%-shared build",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "predb:studio": "pnpm --filter %%SAPPORTA:SLUG%%-shared build",
    "db:studio": "drizzle-kit studio",
    "pretypecheck": "pnpm --filter %%SAPPORTA:SLUG%%-shared build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@casl/ability": "%%SAPPORTA:CASL_ABILITY_VERSION%%",
    "@sapporta/honest": "%%SAPPORTA:HONEST_SPEC%%",
    "@sapporta/rest-core": "%%SAPPORTA:SAPPORTA_REST_CORE_VERSION%%",
    "@sapporta/server": "%%SAPPORTA:CORE_SPEC%%",
    "@sapporta/shared": "%%SAPPORTA:SHARED_SPEC%%",
    "%%SAPPORTA:SLUG%%-shared": "workspace:*",
    "@better-auth/drizzle-adapter": "%%SAPPORTA:BETTER_AUTH_VERSION%%",
    "better-auth": "%%SAPPORTA:BETTER_AUTH_VERSION%%",
    "@hono/node-server": "%%SAPPORTA:HONO_NODE_SERVER_SPEC%%",
    "hono": "%%SAPPORTA:HONO_SPEC%%",
    "nodemailer": "%%SAPPORTA:NODEMAILER_VERSION%%",
    "drizzle-orm": "%%SAPPORTA:DRIZZLE_VERSION%%",
    "better-sqlite3": "%%SAPPORTA:BETTER_SQLITE3_VERSION%%",
    "@js-temporal/polyfill": "%%SAPPORTA:TEMPORAL_VERSION%%",
    "zod": "%%SAPPORTA:ZOD_VERSION%%"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsc-watch": "^7.2.0",
    "drizzle-kit": "%%SAPPORTA:DRIZZLE_KIT_VERSION%%",
    "@types/better-sqlite3": "^7.6.0",
    "@types/nodemailer": "%%SAPPORTA:TYPES_NODEMAILER_VERSION%%",
    "vitest": "^3.1.0"
  }
}
