{
  "name": "__SLUG__-api",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter __SLUG__-shared build",
    "dev": "tsc-watch --onFirstSuccess \"node --watch dist/boot.js\"",
    "prebuild": "pnpm --filter __SLUG__-shared build",
    "build": "tsc",
    "start": "node dist/boot.js",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "pretypecheck": "pnpm --filter __SLUG__-shared build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sapporta/honest": "__HONEST_SPEC__",
    "@sapporta/rest-core": "__SAPPORTA_REST_CORE_VERSION__",
    "@sapporta/server": "__CORE_SPEC__",
    "@sapporta/shared": "__SHARED_SPEC__",
    "__SLUG__-shared": "workspace:*",
    "@hono/node-server": "__HONO_NODE_SERVER_SPEC__",
    "hono": "__HONO_SPEC__",
    "drizzle-orm": "__DRIZZLE_VERSION__",
    "better-sqlite3": "__BETTER_SQLITE3_VERSION__",
    "@js-temporal/polyfill": "__TEMPORAL_VERSION__",
    "zod": "__ZOD_VERSION__"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsc-watch": "^7.2.0",
    "drizzle-kit": "__DRIZZLE_KIT_VERSION__",
    "@types/better-sqlite3": "^7.6.0",
    "vitest": "^3.1.0"
  }
}
