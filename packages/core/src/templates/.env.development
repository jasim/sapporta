# Local ports for this project, picked at random by `sapporta init` so several
# Sapporta projects can run on one machine. `pnpm dev` prints both as URLs when
# it starts, and stops with the setting to change when either port is taken.
SAPPORTA_API_PORT=%%SAPPORTA:DEV_API_PORT%%
SAPPORTA_FRONTEND_PORT=%%SAPPORTA:DEV_FRONTEND_PORT%%

BETTER_AUTH_SECRET=%%SAPPORTA:BETTER_AUTH_DEV_SECRET%%

# The origin a browser loads this app from, used for sign-in and for links in
# outgoing email. In development the browser loads the app from Vite, so this
# carries SAPPORTA_FRONTEND_PORT and must be updated alongside it. A deployment
# sets this to its own domain, which has no relation to the ports above.
SAPPORTA_PUBLIC_APP_URL=http://localhost:%%SAPPORTA:DEV_FRONTEND_PORT%%

# In development /api/* is reached through Vite's proxy on SAPPORTA_PUBLIC_APP_URL.
# Set SAPPORTA_FRONTEND_ORIGINS only when you need additional browser origins.
SAPPORTA_HEALTH_POLICY=public

# Serve the app contract at /api/openapi.json without sign-in, so
# `pnpm exec sapporta endpoints list` works with no access token. The document
# describes this project's own routes and schemas, which are already in the
# source beside it. Deployments leave this unset or set `authenticated`.
SAPPORTA_OPENAPI_POLICY=public

SAPPORTA_MAIL_TRANSPORT=stream
SAPPORTA_MAIL_FROM="Sapporta <no-reply@example.test>"

SMTP_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Lets `pnpm seed` create the sample-data account named in
# `packages/api/seed.ts`, whose password is written in that file. Development
# only: no deployment should ever carry this setting.
SAPPORTA_ALLOW_SAMPLE_DATA_SEEDING=true
