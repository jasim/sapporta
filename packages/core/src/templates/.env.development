PORT=3000
FRONTEND_DEV_PORT=5173

BETTER_AUTH_SECRET=__BETTER_AUTH_DEV_SECRET__
SAPPORTA_PUBLIC_BASE_URL=http://localhost:5173

# In development /api/* is reached through Vite's proxy on SAPPORTA_PUBLIC_BASE_URL.
# Set SAPPORTA_FRONTEND_ORIGINS only when you need additional browser origins.
SAPPORTA_REQUIRE_VERIFIED_EMAIL=false
SAPPORTA_HEALTH_POLICY=public

SAPPORTA_MAIL_TRANSPORT=stream
SAPPORTA_MAIL_FROM="Sapporta <no-reply@example.test>"

SMTP_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
