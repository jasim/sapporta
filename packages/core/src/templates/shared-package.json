{
  "name": "@sapporta/shared",
  "version": "0.1.1",
  "type": "module",
  "description": "Types and pure helpers shared between @sapporta/server and @sapporta/ui. Leaf package — must not depend on either.",
  "keywords": [
    "sapporta",
    "types",
    "zod",
    "filter",
    "temporal",
    "typescript"
  ],
  "author": "Jasim A Basheer <jasim@nuabase.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasim/sapporta.git",
    "directory": "packages/shared"
  },
  "homepage": "https://github.com/jasim/sapporta/tree/master/packages/shared#readme",
  "bugs": "https://github.com/jasim/sapporta/issues",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./filter": {
      "types": "./dist/filter.d.ts",
      "import": "./dist/filter.js"
    },
    "./value-kind": {
      "types": "./dist/value-kind.d.ts",
      "import": "./dist/value-kind.js"
    },
    "./temporal": {
      "types": "./dist/temporal.d.ts",
      "import": "./dist/temporal.js"
    },
    "./daterange": {
      "types": "./dist/daterange.d.ts",
      "import": "./dist/daterange.js"
    },
    "./row-id": {
      "types": "./dist/row-id.d.ts",
      "import": "./dist/row-id.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.build.tsbuildinfo && tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@sapporta/rest-core": "3.52.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@sapporta/rest-core": "3.52.2",
    "typescript": "^5.7.3",
    "zod": "^4.3.6"
  }
}
