{
  "name": "%%SAPPORTA:NAME%%",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "predev": "pnpm run clean && pnpm --filter ./packages/shared build",
    "dev": "node --env-file=.env.development scripts/dev.mjs",
    "dev:server": "pnpm --filter ./packages/api dev",
    "dev:ui": "pnpm --filter ./packages/frontend dev",
    "prebuild": "pnpm run clean",
    "build": "pnpm --filter ./packages/shared build && pnpm --filter ./packages/api build && pnpm --filter ./packages/frontend build",
    "start": "pnpm --filter ./packages/api start"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
