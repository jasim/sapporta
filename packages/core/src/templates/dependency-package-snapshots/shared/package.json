{
  "name": "@sapporta/shared",
  "version": "0.1.5",
  "type": "module",
  "description": "Types and pure helpers shared between @sapporta/server and @sapporta/ui. Leaf package — must not depend on either.",
  "keywords": [
    "sapporta",
    "types",
    "zod",
    "filter",
    "temporal",
    "typescript"
  ],
  "author": "Jasim A Basheer <jasim@protoship.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasim/sapporta.git",
    "directory": "packages/shared"
  },
  "homepage": "https://github.com/jasim/sapporta/tree/main/packages/shared#readme",
  "bugs": {
    "url": "https://github.com/jasim/sapporta/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "package.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./filter": "./dist/filter.js",
    "./value-kind": "./dist/value-kind.js",
    "./temporal": "./dist/temporal.js",
    "./daterange": "./dist/daterange.js",
    "./grid-dataset": "./dist/grid-dataset/index.js",
    "./row-id": "./dist/row-id.js",
    "./validation": "./dist/validation/index.js",
    "./contracts": "./dist/contracts/index.js",
    "./client": "./dist/client/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "zx ../../scripts/build-package.mjs",
    "build:watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@sapporta/rest-core": "3.52.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@sapporta/rest-core": "3.52.2",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  }
}
