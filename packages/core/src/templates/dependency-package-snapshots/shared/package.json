{
  "name": "@sapporta/shared",
  "version": "0.2.1",
  "type": "module",
  "description": "Types and pure helpers shared between @sapporta/server and @sapporta/ui. Leaf package — must not depend on either.",
  "keywords": [
    "sapporta",
    "types",
    "zod",
    "filter",
    "temporal",
    "typescript"
  ],
  "author": "Jasim A Basheer <jasim@protoship.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasim/sapporta.git",
    "directory": "packages/shared"
  },
  "homepage": "https://github.com/jasim/sapporta/tree/main/packages/shared#readme",
  "bugs": {
    "url": "https://github.com/jasim/sapporta/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "package.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "sapporta:source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./filter": {
      "types": "./dist/filter.d.ts",
      "sapporta:source": "./src/filter.ts",
      "default": "./dist/filter.js"
    },
    "./value-kind": {
      "types": "./dist/value-kind.d.ts",
      "sapporta:source": "./src/value-kind.ts",
      "default": "./dist/value-kind.js"
    },
    "./temporal": {
      "types": "./dist/temporal.d.ts",
      "sapporta:source": "./src/temporal.ts",
      "default": "./dist/temporal.js"
    },
    "./daterange": {
      "types": "./dist/daterange.d.ts",
      "sapporta:source": "./src/daterange.ts",
      "default": "./dist/daterange.js"
    },
    "./csv": {
      "types": "./dist/csv.d.ts",
      "sapporta:source": "./src/csv.ts",
      "default": "./dist/csv.js"
    },
    "./grid-dataset": {
      "types": "./dist/grid-dataset/index.d.ts",
      "sapporta:source": "./src/grid-dataset/index.ts",
      "default": "./dist/grid-dataset/index.js"
    },
    "./row-id": {
      "types": "./dist/row-id.d.ts",
      "sapporta:source": "./src/row-id.ts",
      "default": "./dist/row-id.js"
    },
    "./row-scope": {
      "types": "./dist/row-scope.d.ts",
      "sapporta:source": "./src/row-scope.ts",
      "default": "./dist/row-scope.js"
    },
    "./error": {
      "types": "./dist/error.d.ts",
      "sapporta:source": "./src/error.ts",
      "default": "./dist/error.js"
    },
    "./validation": {
      "types": "./dist/validation/index.d.ts",
      "sapporta:source": "./src/validation/index.ts",
      "default": "./dist/validation/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "sapporta:source": "./src/contracts/index.ts",
      "default": "./dist/contracts/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "sapporta:source": "./src/client/index.ts",
      "default": "./dist/client/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "zx ../../scripts/build-package.mjs",
    "build:watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@sapporta/rest-core": "3.52.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@sapporta/rest-core": "3.52.2",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  }
}
