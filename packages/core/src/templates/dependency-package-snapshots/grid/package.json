{
  "name": "@sapporta/grid",
  "version": "0.2.5",
  "type": "module",
  "description": "Sapporta grid runtime, React grid components, column presets, and lookup primitives.",
  "keywords": [
    "sapporta",
    "grid",
    "react",
    "typescript"
  ],
  "author": "Jasim A Basheer <jasim@protoship.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasim/sapporta.git",
    "directory": "packages/grid"
  },
  "homepage": "https://github.com/jasim/sapporta/tree/main/packages/grid#readme",
  "bugs": {
    "url": "https://github.com/jasim/sapporta/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "src/",
    "package.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./grid": {
      "types": "./dist/grid/index.d.ts",
      "import": "./dist/grid.js"
    },
    "./column-preset": {
      "types": "./dist/column-preset/index.d.ts",
      "import": "./dist/column-preset.js"
    },
    "./lookup": {
      "types": "./dist/lookup/index.d.ts",
      "import": "./dist/lookup.js"
    },
    "./lookup/react": {
      "types": "./dist/lookup/react/index.d.ts",
      "import": "./dist/lookup/react.js"
    },
    "./index.css": "./dist/index.css"
  },
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "bench:runtime": "tsx bench/runtime-bench.ts",
    "bench:runtime:gc": "tsx --expose-gc bench/runtime-bench.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch --preserveWatchOutput",
    "test": "vitest run"
  },
  "dependencies": {
    "@sapporta/ui": "workspace:*",
    "lucide-react": "^0.513.0"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.0.5",
    "zustand": "^5.0.5"
  }
}
