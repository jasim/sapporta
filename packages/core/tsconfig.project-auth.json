{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": ".",
    "noEmit": true,
    "paths": {
      "@sapporta/server": ["./src/index.ts"],
      "@sapporta/server/data-dir": ["./src/project/data-dir.ts"],
      "%%SAPPORTA:SLUG%%-shared": [
        "./src/templates/packages/shared/src/index.ts"
      ]
    }
  },
  "include": [
    "src/templates/packages/api/**/*.ts",
    "src/templates/packages/shared/src/**/*.ts",
    "template-tests/**/*.ts"
  ],
  "references": [
    { "path": "." },
    { "path": "../shared" },
    { "path": "../honest" }
  ],
  "exclude": []
}
