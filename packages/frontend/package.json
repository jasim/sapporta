{
  "name": "@sapporta/frontend",
  "version": "0.2.5",
  "type": "module",
  "description": "Sapporta default admin frontend: shell, routes, table pages, report pages, and app boot wiring.",
  "keywords": [
    "sapporta",
    "admin",
    "crud",
    "react",
    "vite",
    "typescript"
  ],
  "author": "Jasim A Basheer <jasim@protoship.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasim/sapporta.git",
    "directory": "packages/frontend"
  },
  "homepage": "https://github.com/jasim/sapporta/tree/main/packages/frontend#readme",
  "bugs": {
    "url": "https://github.com/jasim/sapporta/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "src/",
    "package.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app/index.d.ts",
      "import": "./dist/app.js"
    },
    "./platform": {
      "types": "./dist/platform/index.d.ts",
      "import": "./dist/platform.js"
    },
    "./schema": {
      "types": "./dist/schema-catalog/index.d.ts",
      "import": "./dist/schema.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth.js"
    },
    "./auth/runtime": {
      "types": "./dist/auth/runtime.d.ts",
      "import": "./dist/auth/runtime.js"
    },
    "./auth/pages": {
      "types": "./dist/auth/pages.d.ts",
      "import": "./dist/auth/pages.js"
    },
    "./routes/table": {
      "types": "./dist/routes/table.d.ts",
      "import": "./dist/routes/table.js"
    },
    "./routes/new-record": {
      "types": "./dist/routes/new-record.d.ts",
      "import": "./dist/routes/new-record.js"
    },
    "./report": {
      "types": "./dist/report/index.d.ts",
      "import": "./dist/report.js"
    },
    "./layout": {
      "types": "./dist/shell/components/SidebarShell.d.ts",
      "import": "./dist/layout.js"
    },
    "./shell": {
      "types": "./dist/shell.d.ts",
      "import": "./dist/shell.js"
    },
    "./index.css": "./dist/index.css"
  },
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@sapporta/grid": "workspace:*",
    "@sapporta/shared": "workspace:*",
    "@sapporta/ui": "workspace:*",
    "immer": "^10.1.1",
    "lucide-react": "^0.513.0"
  },
  "peerDependencies": {
    "@sapporta/rest-core": "3.52.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.13.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@sapporta/rest-core": "3.52.2",
    "@tailwindcss/vite": "^4.1.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.13.1",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.7.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "zod": "^4.3.6",
    "zustand": "^5.0.5"
  }
}
