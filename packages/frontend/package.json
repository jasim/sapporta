{
  "name": "@sapporta/frontend",
  "version": "0.2.3",
  "type": "module",
  "description": "Sapporta default admin frontend: shell, routes, table pages, report pages, and app boot wiring.",
  "keywords": [
    "sapporta",
    "admin",
    "crud",
    "react",
    "vite",
    "typescript"
  ],
  "author": "Jasim A Basheer <jasim@protoship.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasim/sapporta.git",
    "directory": "packages/frontend"
  },
  "homepage": "https://github.com/jasim/sapporta/tree/main/packages/frontend#readme",
  "bugs": {
    "url": "https://github.com/jasim/sapporta/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "src/",
    "index.html",
    "package.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app/index.d.ts",
      "import": "./dist/app/index.js"
    },
    "./layout": {
      "types": "./dist/shell/components/SidebarShell.d.ts",
      "import": "./dist/layout.js"
    },
    "./index.css": "./dist/index.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch --preserveWatchOutput",
    "preview": "vite preview",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@sapporta/grid": "workspace:*",
    "@sapporta/shared": "workspace:*",
    "@sapporta/ui": "workspace:*",
    "immer": "^10.1.1",
    "lucide-react": "^0.513.0"
  },
  "peerDependencies": {
    "@sapporta/rest-core": "3.52.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.13.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@sapporta/rest-core": "3.52.2",
    "@tailwindcss/vite": "^4.1.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.13.1",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.7.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "zod": "^4.3.6",
    "zustand": "^5.0.5"
  }
}
