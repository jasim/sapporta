{
  "name": "@sapporta/ui",
  "version": "0.2.10",
  "type": "module",
  "description": "Sapporta UI primitives and reusable React utilities.",
  "keywords": [
    "sapporta",
    "react",
    "tailwind",
    "shadcn",
    "typescript"
  ],
  "author": "Jasim A Basheer <jasim@protoship.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasim/sapporta.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/jasim/sapporta/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/jasim/sapporta/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist/",
    "src/",
    "package.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "sapporta:source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./index.css": {
      "sapporta:source": "./src/index.css",
      "default": "./dist/index.css"
    },
    "./alert-dialog": {
      "types": "./dist/ui/primitives/alert-dialog.d.ts",
      "sapporta:source": "./src/ui/primitives/alert-dialog.tsx",
      "default": "./dist/alert-dialog.js"
    },
    "./badge": {
      "types": "./dist/ui/primitives/badge.d.ts",
      "sapporta:source": "./src/ui/primitives/badge.tsx",
      "default": "./dist/badge.js"
    },
    "./button": {
      "types": "./dist/ui/primitives/button.d.ts",
      "sapporta:source": "./src/ui/primitives/button.tsx",
      "default": "./dist/button.js"
    },
    "./checkbox": {
      "types": "./dist/ui/primitives/checkbox.d.ts",
      "sapporta:source": "./src/ui/primitives/checkbox.tsx",
      "default": "./dist/checkbox.js"
    },
    "./context-menu": {
      "types": "./dist/ui/primitives/context-menu.d.ts",
      "sapporta:source": "./src/ui/primitives/context-menu.tsx",
      "default": "./dist/context-menu.js"
    },
    "./dialog": {
      "types": "./dist/ui/primitives/dialog.d.ts",
      "sapporta:source": "./src/ui/primitives/dialog.tsx",
      "default": "./dist/dialog.js"
    },
    "./input": {
      "types": "./dist/ui/primitives/input.d.ts",
      "sapporta:source": "./src/ui/primitives/input.tsx",
      "default": "./dist/input.js"
    },
    "./label": {
      "types": "./dist/ui/primitives/label.d.ts",
      "sapporta:source": "./src/ui/primitives/label.tsx",
      "default": "./dist/label.js"
    },
    "./popover": {
      "types": "./dist/ui/primitives/popover.d.ts",
      "sapporta:source": "./src/ui/primitives/popover.tsx",
      "default": "./dist/popover.js"
    },
    "./sheet": {
      "types": "./dist/ui/primitives/sheet.d.ts",
      "sapporta:source": "./src/ui/primitives/sheet.tsx",
      "default": "./dist/sheet.js"
    },
    "./switch": {
      "types": "./dist/ui/primitives/switch.d.ts",
      "sapporta:source": "./src/ui/primitives/switch.tsx",
      "default": "./dist/switch.js"
    },
    "./tooltip": {
      "types": "./dist/ui/primitives/tooltip.d.ts",
      "sapporta:source": "./src/ui/primitives/tooltip.tsx",
      "default": "./dist/tooltip.js"
    },
    "./combobox": {
      "types": "./dist/ui/styles/combobox.d.ts",
      "sapporta:source": "./src/ui/styles/combobox.ts",
      "default": "./dist/combobox.js"
    },
    "./kbd": {
      "types": "./dist/ui/composite/kbd.d.ts",
      "sapporta:source": "./src/ui/composite/kbd.tsx",
      "default": "./dist/kbd.js"
    },
    "./param-pill": {
      "types": "./dist/ui/composite/param-pill.d.ts",
      "sapporta:source": "./src/ui/composite/param-pill.tsx",
      "default": "./dist/param-pill.js"
    },
    "./cn": {
      "types": "./dist/ui/utils/cn.d.ts",
      "sapporta:source": "./src/ui/utils/cn.ts",
      "default": "./dist/cn.js"
    },
    "./use-debounce": {
      "types": "./dist/ui/hooks/useDebounce.d.ts",
      "sapporta:source": "./src/ui/hooks/useDebounce.ts",
      "default": "./dist/use-debounce.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "typecheck:watch": "tsc --noEmit --watch --preserveWatchOutput",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "lucide-react": "^1.21.0",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.9"
  }
}
