{
  "name": "@sapporta/monorepo",
  "private": true,
  "packageManager": "pnpm@11.1.1+sha512.d1fdf5f73c617b64fa1a56a81c3c8dfe0e966e33a6010aa256b517ae77be21d93e05affc0de1a83b0e4f29d569f68b446ae8f068cd7247c0bb3df0fb4d7bdf9a",
  "scripts": {
    "dev:ui": "pnpm --filter @sapporta/ui dev",
    "dev": "pnpm -r build && pnpm typecheck && pnpm -r --parallel --stream --if-present \"/^(build:watch|typecheck:watch)$/\"",
    "typecheck": "tsc --build",
    "pretest": "tsc -p packages/core/tsconfig.fixtures.json",
    "test": "vitest run",
    "pretest:watch": "tsc -p packages/core/tsconfig.fixtures.json",
    "test:watch": "vitest",
    "pretest:e2e": "pnpm --filter @sapporta/server build",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "sapporta": "node packages/core/bin/sapporta.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.3.0",
    "drizzle-kit": "^0.31.9",
    "happy-dom": "^20.9.0",
    "prettier": "^3.8.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "zx": "^8.8.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
