{
  "name": "@sapporta/monorepo",
  "private": true,
  "packageManager": "pnpm@11.1.1+sha512.d1fdf5f73c617b64fa1a56a81c3c8dfe0e966e33a6010aa256b517ae77be21d93e05affc0de1a83b0e4f29d569f68b446ae8f068cd7247c0bb3df0fb4d7bdf9a",
  "scripts": {
    "dev:ui": "pnpm --filter @sapporta/frontend dev",
    "dev:frontend": "pnpm --filter @sapporta/frontend dev",
    "dev": "zx scripts/dev.mjs",
    "check:public-declarations": "node scripts/check-public-declarations.mjs",
    "check:peer-singletons": "node scripts/check-peer-singletons.mjs .",
    "check:peer-compat:lock": "node scripts/check-peer-compat.mjs lock",
    "check:peer-compat:min": "node scripts/check-peer-compat.mjs minimum",
    "check:peer-compat:latest": "node scripts/check-peer-compat.mjs latest-in-range",
    "check:scaffold-bundle": "node scripts/scaffold-bundle-report.mjs",
    "scaffold:refresh": "pnpm exec tsx scripts/refresh-scaffold-project.ts",
    "typecheck": "tsc --build",
    "pretest": "zx scripts/test.mjs prepare-unit",
    "test": "zx scripts/test.mjs unit",
    "pretest:watch": "zx scripts/test.mjs prepare-unit",
    "test:watch": "zx scripts/test.mjs watch",
    "pretest:e2e": "zx scripts/test.mjs prepare-e2e",
    "test:e2e": "zx scripts/test.mjs e2e",
    "test:e2e:npm": "zx scripts/test.mjs e2e-npm",
    "test:e2e:npm:docker": "zx scripts/test.mjs e2e-npm-docker",
    "pretest:e2e:docker": "zx scripts/test.mjs prepare-e2e",
    "test:e2e:docker": "zx scripts/test.mjs e2e-docker",
    "sapporta": "node packages/core/bin/sapporta.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.3.0",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^20.9.0",
    "prettier": "^3.8.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "zx": "^8.8.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
