{
  "name": "@sapporta/monorepo",
  "private": true,
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "scripts": {
    "dev": "zx scripts/dev.mjs",
    "check:public-declarations": "node scripts/check-public-declarations.mjs",
    "check:peer-compat:lock": "node scripts/check-peer-compat.mjs lock",
    "check:peer-compat:min": "node scripts/check-peer-compat.mjs minimum",
    "check:peer-compat:latest": "node scripts/check-peer-compat.mjs latest-in-range",
    "check:scaffold-bundle": "node scripts/scaffold-bundle-report.mjs",
    "scaffold:refresh": "pnpm exec tsx scripts/refresh-scaffold-project.ts",
    "build": "pnpm -r --sort --if-present build",
    "typecheck": "tsc --build",
    "pretest": "zx scripts/test.mjs prepare-unit",
    "test": "zx scripts/test.mjs unit",
    "pretest:watch": "zx scripts/test.mjs prepare-unit",
    "test:watch": "zx scripts/test.mjs watch",
    "pretest:e2e": "pnpm e2e:install-browser && zx scripts/test.mjs prepare-e2e",
    "test:e2e": "zx scripts/test.mjs e2e",
    "pretest:e2e:browser": "pnpm e2e:install-browser && zx scripts/test.mjs prepare-e2e",
    "test:e2e:browser": "vitest run --config vitest.e2e.config.ts e2e/browser-library-workflow.test.ts",
    "e2e:install-browser": "playwright install chromium",
    "test:e2e:npm": "zx scripts/test.mjs e2e-npm",
    "test:e2e:npm:docker": "zx scripts/test.mjs e2e-npm-docker",
    "pretest:e2e:docker": "zx scripts/test.mjs prepare-e2e",
    "test:e2e:docker": "zx scripts/test.mjs e2e-docker",
    "sapporta": "node packages/cli/bin/sapporta.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@playwright/test": "^1.62.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.0.1",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^20.10.6",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "zx": "^8.8.5"
  }
}
